---
import { type Locale, useTranslations, localizedPath } from '../i18n';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const path = Astro.url.pathname;

const home = localizedPath('/', locale);
const account = localizedPath('/account', locale);
const links = [
  { href: localizedPath('/catalog', locale), label: t('nav.catalog') },
  { href: localizedPath('/content', locale), label: t('nav.content') },
  { href: localizedPath('/consulting', locale), label: t('nav.consulting') },
];

const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md"
>
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={home} class="group flex items-center gap-2 font-extrabold tracking-tight">
      <span
        class="inline-block h-2.5 w-2.5 rounded-full bg-brand transition-transform group-hover:scale-125"
      ></span>
      <span class="text-lg">tsunagi</span>
    </a>

    <!-- desktop nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
              isActive(l.href)
                ? 'text-brand'
                : 'text-ink-soft hover:bg-brand-soft hover:text-brand',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitcher locale={locale} />
      <a
        href={account}
        class="hidden rounded-lg border border-line-strong px-3 py-1.5 text-sm font-semibold text-ink-soft transition-colors hover:border-brand hover:text-brand sm:inline-block"
      >
        {t('nav.account')}
      </a>

      <!-- mobile menu -->
      <details class="relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-line-strong"
          aria-label={t('nav.menu')}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 mt-2 w-52 rounded-xl border border-line bg-surface p-2 shadow-[var(--shadow-card)]"
          aria-label="mobile"
        >
          {
            links.map((l) => (
              <a
                href={l.href}
                class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink-soft hover:bg-brand-soft hover:text-brand"
              >
                {l.label}
              </a>
            ))
          }
          <a
            href={account}
            class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink-soft hover:bg-brand-soft hover:text-brand"
          >
            {t('nav.account')}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

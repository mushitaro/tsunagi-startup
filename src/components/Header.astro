---
import { type Locale, useTranslations, localizedPath } from '../i18n';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const path = Astro.url.pathname;

const home = localizedPath('/', locale);
const account = localizedPath('/account', locale);
const links = [
  { href: localizedPath('/tsukuru', locale), label: t('nav.catalog') },
  { href: localizedPath('/tsutae', locale), label: t('nav.content') },
  { href: localizedPath('/tsunagu', locale), label: t('nav.consulting') },
];

const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/92 backdrop-blur-md">
  <div class="wrap grid h-20 grid-cols-[1fr_auto_1fr] items-center gap-6">
    <a href={home} aria-label="tsunagi" class="justify-self-start">
      <img src="/brand-icon.png" alt="tsunagi" width="30" height="30" class="block h-[30px] w-[30px]" />
    </a>

    <nav class="hidden items-center gap-10 md:flex" aria-label="primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'font-display text-[15px] tracking-wide transition-colors',
              isActive(l.href)
                ? 'text-ink underline decoration-1 underline-offset-[6px]'
                : 'text-muted hover:text-ink',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4 justify-self-end md:gap-5">
      <LangSwitcher locale={locale} />
      <span class="hidden h-3 w-px bg-line-strong md:block" aria-hidden="true"></span>
      <a
        href={account}
        class="hidden text-[13px] font-semibold tracking-wide text-muted transition-colors hover:text-ink md:inline-block"
      >
        {t('nav.account')}
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-8 w-8 cursor-pointer list-none items-center justify-center text-ink"
          aria-label={t('nav.menu')}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 7h18M3 17h18" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 mt-3 w-56 border border-line-strong bg-surface py-1"
          aria-label="mobile"
        >
          {
            [...links, { href: account, label: t('nav.account') }].map((l) => (
              <a
                href={l.href}
                class="block px-5 py-3 font-display text-[15px] tracking-wide text-ink-soft hover:bg-brand-soft hover:text-ink"
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

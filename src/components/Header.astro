---
import { type Locale, useTranslations, localizedPath } from '../i18n';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const path = Astro.url.pathname;

const home = localizedPath('/', locale);
const account = localizedPath('/account', locale);
const links = [
  { href: localizedPath('/catalog', locale), label: t('nav.catalog') },
  { href: localizedPath('/content', locale), label: t('nav.content') },
  { href: localizedPath('/consulting', locale), label: t('nav.consulting') },
];

const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
  <div class="wrap flex h-20 items-center justify-between gap-6">
    <a
      href={home}
      class="font-display text-xl font-bold uppercase tracking-[0.34em] text-ink"
      aria-label="tsunagi"
    >
      TSUNAGI
    </a>

    <!-- desktop nav -->
    <nav class="hidden items-center gap-9 md:flex" aria-label="primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'text-[13px] font-semibold tracking-wide transition-colors',
              isActive(l.href)
                ? 'text-ink underline decoration-1 underline-offset-[6px]'
                : 'text-muted hover:text-ink',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-5">
      <LangSwitcher locale={locale} />
      <a
        href={account}
        class="hidden text-[13px] font-semibold tracking-wide text-muted transition-colors hover:text-ink sm:inline-block"
      >
        {t('nav.account')}
      </a>

      <!-- mobile menu -->
      <details class="relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center border border-line-strong text-ink"
          aria-label={t('nav.menu')}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 mt-2 w-56 border border-line-strong bg-surface p-1"
          aria-label="mobile"
        >
          {
            [...links, { href: account, label: t('nav.account') }].map((l) => (
              <a
                href={l.href}
                class="block px-4 py-3 text-[13px] font-semibold tracking-wide text-ink-soft hover:bg-brand-soft"
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

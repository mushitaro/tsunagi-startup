---
// 計測タグ。ビルド時の PUBLIC_ 環境変数が設定されているときだけ出力する。
// 値が無ければ何も描画しない（安全）。値はクライアントに露出する公開値（シークレットではない）。
//
//   PUBLIC_GSC_VERIFICATION  … Google Search Console の site verification トークン
//   PUBLIC_GA4_ID            … Google Analytics 4 の測定ID（例: G-XXXXXXX）。未指定なら tsunagi.app の既定IDを使う。
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
// tsunagi.app の GA4 測定ID（公開値）。環境変数があれば上書きできる。
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? 'G-Z11WPND2Z3';
---
{gsc && <meta name="google-site-verification" content={gsc} />}
{
  ga4Id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script is:inline define:vars={{ ga4Id }}>
        {`window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', ga4Id);`}
      </script>
    </>
  )
}

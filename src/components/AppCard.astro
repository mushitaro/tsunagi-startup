---
import { type Locale, localizedPath } from '../i18n';
import { type AppEntry, pick } from '../lib/content';
import Badge from './Badge.astro';

interface Props {
  app: AppEntry;
  locale: Locale;
  index?: number;
}
const { app, locale, index } = Astro.props;
const d = app.data;

const name = pick(d.name, locale);
const tagline = pick(d.tagline, locale);
const href = localizedPath(`/tsukuru/${app.id}`, locale);

const statusMap = {
  live: { ja: '公開中', en: 'Live', tone: 'solid' as const },
  'in-development': { ja: '開発中', en: 'In dev', tone: 'line' as const },
  planned: { ja: '構想中', en: 'Planned', tone: 'line' as const },
};
const status = statusMap[d.status];
---

<a
  href={href}
  class="group flex h-full flex-col border border-line bg-surface p-8 transition-colors duration-150 hover:border-line-strong hover:bg-brand-soft md:p-10"
>
  <div class="flex items-center justify-between">
    <span class="index-num text-lg text-faint">
      {index !== undefined ? String(index + 1).padStart(2, '0') : ''}
    </span>
    <Badge tone={status.tone}>{status[locale]}</Badge>
  </div>

  {
    d.thumbnail && (
      <img
        src={d.thumbnail}
        alt=""
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
        class="mt-7 aspect-[16/9] w-full border border-line object-cover"
      />
    )
  }

  <h3
    class="mt-7 text-2xl font-bold leading-snug text-ink decoration-1 underline-offset-4 group-hover:underline"
  >
    {name}
  </h3>
  <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted">{tagline}</p>

  {
    d.tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-x-4 gap-y-1">
        {d.tags.slice(0, 4).map((tag) => (
          <span class="text-[11px] tracking-wide text-faint">{tag}</span>
        ))}
      </div>
    )
  }
</a>

---
import { type Locale, useTranslations, localizedPath } from '../i18n';
import { type ArticleEntry, entrySlug, formatPrice } from '../lib/content';

interface Props {
  locale: Locale;
  article: ArticleEntry;
  loggedIn: boolean;
}
const { locale, article, loggedIn } = Astro.props;
const t = useTranslations(locale);
const slug = entrySlug(article.id);
const price = article.data.price ?? 0;
const loginHref =
  localizedPath('/account', locale) + '?next=' + encodeURIComponent(Astro.url.pathname);
---

<div
  class="relative mt-2 overflow-hidden rounded-2xl border border-line bg-surface p-8 text-center"
>
  <div
    class="pointer-events-none absolute inset-x-0 -top-20 h-24 bg-gradient-to-b from-transparent to-paper"
    aria-hidden="true"
  >
  </div>
  <div
    class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-soft text-brand"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4" y="10" width="16" height="11" rx="2.5" stroke="currentColor" stroke-width="2" />
      <path d="M8 10V7a4 4 0 1 1 8 0v3" stroke="currentColor" stroke-width="2" />
    </svg>
  </div>
  <h2 class="mt-4 text-xl font-extrabold tracking-tight">{t('paywall.title')}</h2>
  <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted">{t('paywall.desc')}</p>

  <p class="mt-5 text-2xl font-extrabold text-ink">{formatPrice(price, article.data.currency)}</p>

  {
    loggedIn ? (
      <form method="POST" action="/api/checkout" class="mt-4">
        <input type="hidden" name="slug" value={slug} />
        <input type="hidden" name="locale" value={locale} />
        <button
          type="submit"
          class="rounded-xl bg-brand px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-ink"
        >
          {t('paywall.buy')}
        </button>
      </form>
    ) : (
      <div class="mt-4">
        <p class="text-xs text-muted">{t('paywall.login.note')}</p>
        <a
          href={loginHref}
          class="mt-2 inline-block rounded-xl bg-brand px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-ink"
        >
          {t('paywall.login.cta')}
        </a>
      </div>
    )
  }
</div>

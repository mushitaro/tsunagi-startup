---
import { type Locale, locales, switchLocalePath } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const path = Astro.url.pathname;
---

<div class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.12em]" aria-label="language">
  {
    locales.map((l, i) => (
      <>
        {i > 0 && <span class="text-line-strong" aria-hidden="true">/</span>}
        <a
          href={switchLocalePath(path, l)}
          aria-current={l === locale ? 'true' : undefined}
          class:list={[
            'uppercase transition-colors',
            l === locale ? 'text-ink' : 'text-faint hover:text-ink',
          ]}
        >
          {l}
        </a>
      </>
    ))
  }
</div>

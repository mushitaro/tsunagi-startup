---
interface Props {
  tone?: 'solid' | 'line';
  class?: string;
}
const { tone = 'line', class: cls } = Astro.props;
const tones: Record<string, string> = {
  solid: 'bg-ink text-paper',
  line: 'border border-line-strong text-muted',
};
---

<span
  class:list={[
    'inline-flex items-center px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em]',
    tones[tone],
    cls,
  ]}
>
  <slot />
</span>

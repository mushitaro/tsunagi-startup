---
interface Props {
  tone?: 'brand' | 'neutral' | 'live' | 'dev' | 'paid';
  class?: string;
}
const { tone = 'neutral', class: cls } = Astro.props;
const tones: Record<string, string> = {
  brand: 'bg-brand-soft text-ink-soft',
  neutral: 'border border-line-strong text-muted',
  live: 'bg-ink text-white',
  dev: 'bg-brand-soft text-ink-soft',
  paid: 'bg-ink text-white',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold',
    tones[tone],
    cls,
  ]}
>
  <slot />
</span>

---
// ブランドコンセプトビジュアル: ノードがゆっくり漂い、接近すると線でつながる。
// 「つなぐ」を動きで表現するフルスクリーン背景アニメーション。
---

<canvas
  id="particle-canvas"
  class="absolute inset-0 h-full w-full"
  aria-hidden="true"
></canvas>

<script is:inline>
(function () {
  var canvas = document.getElementById('particle-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  if (!ctx) return;

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- 設定 ----
  var CONNECT_DIST = 170;
  var SPEED        = 0.28;
  var LINE_MAX     = 0.13;
  var ANCHOR_N     = 9;
  function deviceW() { return window.innerWidth; }
  function totalN() { return deviceW() < 640 ? 32 : deviceW() < 1024 ? 52 : 70; }

  function mkNode(w, h, anchor) {
    var speed = SPEED * (0.5 + Math.random() * 0.6);
    var angle = Math.random() * Math.PI * 2;
    return {
      x:  Math.random() * w,
      y:  Math.random() * h,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      r:  anchor ? 2.2 + Math.random() * 0.8 : 1.0 + Math.random() * 1.2,
      a:  anchor ? 0.65 + Math.random() * 0.2 : 0.28 + Math.random() * 0.28,
    };
  }

  // ---- 状態 ----
  var pts = [];
  var raf = 0;
  var W = 0, H = 0;
  var dpr = 1;

  function resize() {
    dpr = Math.min(devicePixelRatio, 2);
    var parent = canvas.parentElement;
    W = (parent ? parent.offsetWidth  : 0) || window.innerWidth;
    H = (parent ? parent.offsetHeight : 0) || window.innerHeight;
    if (W === 0 || H === 0) return;
    canvas.width  = W * dpr;
    canvas.height = H * dpr;
    ctx.scale(dpr, dpr);

    var n = totalN();
    while (pts.length < n) pts.push(mkNode(W, H, pts.length < ANCHOR_N));
    while (pts.length > n) pts.pop();
    for (var i = 0; i < pts.length; i++) {
      if (pts[i].x > W) pts[i].x = Math.random() * W;
      if (pts[i].y > H) pts[i].y = Math.random() * H;
    }
  }

  // ---- 描画 ----
  function draw() {
    ctx.clearRect(0, 0, W, H);

    // 接続線
    for (var i = 0; i < pts.length; i++) {
      for (var j = i + 1; j < pts.length; j++) {
        var dx = pts[i].x - pts[j].x;
        var dy = pts[i].y - pts[j].y;
        var d2 = dx * dx + dy * dy;
        if (d2 < CONNECT_DIST * CONNECT_DIST) {
          var t = 1 - Math.sqrt(d2) / CONNECT_DIST;
          ctx.beginPath();
          ctx.moveTo(pts[i].x, pts[i].y);
          ctx.lineTo(pts[j].x, pts[j].y);
          ctx.strokeStyle = 'rgba(255,255,255,' + (t * t * LINE_MAX).toFixed(3) + ')';
          ctx.lineWidth = 0.6;
          ctx.stroke();
        }
      }
    }

    // ノード
    for (var k = 0; k < pts.length; k++) {
      var p = pts[k];
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255,255,255,' + p.a.toFixed(3) + ')';
      ctx.fill();
    }
  }

  function step() {
    for (var i = 0; i < pts.length; i++) {
      var p = pts[i];
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) { p.x =  0; p.vx *= -1; }
      if (p.x > W) { p.x =  W; p.vx *= -1; }
      if (p.y < 0) { p.y =  0; p.vy *= -1; }
      if (p.y > H) { p.y =  H; p.vy *= -1; }
    }
    draw();
    raf = requestAnimationFrame(step);
  }

  // ---- 初期化 ----
  function start() {
    resize();
    if (W === 0 || H === 0) {
      requestAnimationFrame(start);
      return;
    }
    pts = [];
    var n = totalN();
    for (var i = 0; i < n; i++) pts.push(mkNode(W, H, i < ANCHOR_N));
    if (reduced) {
      draw();
    } else {
      raf = requestAnimationFrame(step);
    }
  }
  requestAnimationFrame(start);

  // リサイズ対応
  var parent = canvas.parentElement;
  if (parent && typeof ResizeObserver !== 'undefined') {
    var ro = new ResizeObserver(function () {
      cancelAnimationFrame(raf);
      resize();
      if (!reduced) raf = requestAnimationFrame(step);
      else draw();
    });
    ro.observe(parent);
  }

  // スクロールアウト時に停止してCPU節約
  if (typeof IntersectionObserver !== 'undefined') {
    var io = new IntersectionObserver(function (entries) {
      for (var ei = 0; ei < entries.length; ei++) {
        if (entries[ei].isIntersecting) {
          if (!reduced && !raf) raf = requestAnimationFrame(step);
        } else {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }
    }, { threshold: 0.01 });
    io.observe(canvas);
  }
})();
</script>

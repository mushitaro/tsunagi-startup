---
import { type Locale, useTranslations, localizedPath } from '../i18n';
import { type ArticleEntry, entrySlug, formatDate, formatPrice } from '../lib/content';

interface Props {
  article: ArticleEntry;
  locale: Locale;
}
const { article, locale } = Astro.props;
const t = useTranslations(locale);
const d = article.data;

const slug = entrySlug(article.id);
const href = localizedPath(`/content/${slug}`, locale);
const paid = d.access === 'paid';
---

<a
  href={href}
  class="group grid grid-cols-[1fr_auto] items-baseline gap-6 border-t border-line py-9 transition-colors duration-150 last:border-b hover:bg-surface"
>
  <div>
    <div class="flex flex-wrap items-center gap-x-4 text-[11px] tracking-wide">
      <time class="text-faint" datetime={d.publishedAt.toISOString()}>
        {formatDate(d.publishedAt, locale)}
      </time>
      {
        paid ? (
          <span class="font-semibold uppercase tracking-[0.16em] text-ink">
            {t('access.paid')}
            {d.price && <span class="ml-1.5">{formatPrice(d.price, d.currency)}</span>}
          </span>
        ) : (
          <span class="uppercase tracking-[0.16em] text-faint">{t('access.free')}</span>
        )
      }
    </div>
    <h3
      class="mt-3 text-xl font-bold leading-snug text-ink decoration-1 underline-offset-4 group-hover:underline md:text-[1.4rem]"
    >
      {d.title}
    </h3>
    <p class="mt-2 line-clamp-2 max-w-2xl text-sm leading-relaxed text-muted">{d.summary}</p>
  </div>
  <span class="text-sm text-faint transition-colors group-hover:text-ink">→</span>
</a>

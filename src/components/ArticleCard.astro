---
import { type Locale, useTranslations, localizedPath } from '../i18n';
import { type ArticleEntry, entrySlug, formatDate, formatPrice } from '../lib/content';
import Badge from './Badge.astro';

interface Props {
  article: ArticleEntry;
  locale: Locale;
}
const { article, locale } = Astro.props;
const t = useTranslations(locale);
const d = article.data;

const slug = entrySlug(article.id);
const href = localizedPath(`/content/${slug}`, locale);
const paid = d.access === 'paid';
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface transition-colors duration-200 hover:border-line-strong"
>
  {
    d.coverImage && (
      <div class="aspect-[16/9] overflow-hidden border-b border-line">
        <img
          src={d.coverImage}
          alt=""
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2">
      <Badge tone={paid ? 'paid' : 'brand'}>{paid ? t('access.paid') : t('access.free')}</Badge>
      {
        paid && d.price && (
          <span class="text-xs font-bold text-muted">{formatPrice(d.price, d.currency)}</span>
        )
      }
      <time
        class="ml-auto text-xs text-faint"
        datetime={d.publishedAt.toISOString()}
      >
        {formatDate(d.publishedAt, locale)}
      </time>
    </div>
    <h3
      class="mt-3 font-bold leading-snug tracking-tight text-ink transition-colors group-hover:text-brand"
    >
      {d.title}
    </h3>
    <p class="mt-1.5 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{d.summary}</p>
  </div>
</a>

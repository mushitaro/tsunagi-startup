---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../ContactForm.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';
import { getConsulting } from '../../lib/content';
import { SITE_URL, breadcrumbSchema, serviceSchema, faqSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const services = await getConsulting(locale);
const rendered = await Promise.all(
  services.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const discordInvite = Astro.locals.runtime?.env?.DISCORD_INVITE_URL || '#';
const contactParam = Astro.url.searchParams.get('contact');
const status =
  contactParam === 'ok' || contactParam === 'error' || contactParam === 'required'
    ? contactParam
    : null;

// アイコン（1パスの簡易 SVG）
const iconPath: Record<string, string> = {
  design: 'M4 20l1-4 9-9 3 3-9 9-4 1z M14 7l3 3',
  build: 'M12 3l9 5v8l-9 5-9-5V8l9-5z M12 12l9-4M12 12v9M12 12L3 8',
  operate: 'M21 12a9 9 0 1 1-2.6-6.3M21 4v5h-5',
};

const faqs =
  locale === 'ja'
    ? [
        {
          question: 'どんな相談ができますか？',
          answer:
            '新規アプリの企画・設計から、既存アプリの開発・改修、公開後の運用改善まで一貫して相談できます。',
        },
        {
          question: '問い合わせ方法は？',
          answer:
            'お問い合わせは Discord に特化しています。サーバーに参加して直接ご相談いただくか、このページのフォームからお送りください。',
        },
        {
          question: '進め方は？',
          answer:
            'まず現状と課題をうかがい、スコープと進め方をすり合わせたうえでお見積もりします。小さく始めて運用しながら育てる進め方を基本にしています。',
        },
      ]
    : [
        {
          question: 'What can I ask about?',
          answer:
            'Everything from planning and designing a new app, to developing and reworking an existing one, to improving operations after launch.',
        },
        {
          question: 'How do I get in touch?',
          answer:
            'Inquiries are handled via Discord. Join the server to talk directly, or send a message with the form on this page.',
        },
        {
          question: 'How does a project proceed?',
          answer:
            'We start by understanding your situation and challenges, align on scope and approach, then provide an estimate. We default to starting small and growing through operation.',
        },
      ];

const base = locale === 'ja' ? SITE_URL : `${SITE_URL}/en`;
const jsonLd = [
  serviceSchema(locale),
  breadcrumbSchema([
    { name: 'tsunagi', url: `${base}/` },
    { name: t('consulting.title'), url: `${base}/consulting` },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  locale={locale}
  title={t('consulting.title')}
  description={t('consulting.lead')}
  jsonLd={jsonLd}
>
  <div class="wrap py-14">
    <header class="max-w-2xl">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{t('consulting.title')}</h1>
      <p class="mt-3 text-base leading-relaxed text-muted">{t('consulting.lead')}</p>
    </header>

    <!-- サービス -->
    <div class="mt-12 space-y-6">
      {
        rendered.map(({ entry, Content }, i) => (
          <section class="rounded-2xl border border-line bg-surface p-6 md:p-8">
            <div class="flex items-start gap-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-soft text-brand">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d={iconPath[entry.data.icon ?? 'build']}
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-faint">0{i + 1}</p>
                <h2 class="text-xl font-extrabold tracking-tight">{entry.data.title}</h2>
                <p class="mt-1 font-semibold text-ink-soft">{entry.data.summary}</p>
              </div>
            </div>
            <div class="article-body mt-4 text-[1rem]">
              <Content />
            </div>
          </section>
        ))
      }
    </div>

    <!-- ポートフォリオへの導線 -->
    <a
      href={localizedPath('/catalog', locale)}
      class="mt-8 flex items-center justify-between gap-4 rounded-2xl border border-line bg-brand-soft px-6 py-5 transition-colors hover:border-brand"
    >
      <span class="font-bold text-brand">
        {locale === 'ja'
          ? '実績は Catalog のプロダクト群をご覧ください'
          : 'See our work in the Catalog'}
      </span>
      <span class="font-bold text-brand">→</span>
    </a>

    <!-- 問い合わせ -->
    <section id="contact" class="mt-16 scroll-mt-24" aria-labelledby="contact-h">
      <div class="rounded-2xl bg-ink p-8 md:p-10">
        <h2 id="contact-h" class="text-2xl font-extrabold tracking-tight text-white">
          {t('consulting.contact.title')}
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/70">
          {t('consulting.contact.desc')}
        </p>
        <a
          href={discordInvite}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-ink transition-colors hover:bg-brand-soft"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.6 5.6A17 17 0 0 0 15.4 4l-.3.5a14 14 0 0 1 3.7 1.9 12 12 0 0 0-12-.1A13 13 0 0 1 10.5 4.5L10.2 4A17 17 0 0 0 6 5.6 18 18 0 0 0 3 17.2a17 17 0 0 0 5.2 2.6l.6-1a11 11 0 0 1-1.8-.9l.4-.3a12 12 0 0 0 10.6 0l.4.3c-.6.4-1.2.7-1.8.9l.6 1a17 17 0 0 0 5.2-2.6 18 18 0 0 0-3-11.6zM9.3 14.7c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm5.4 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z" />
          </svg>
          {t('consulting.contact.join')}
        </a>
      </div>

      <div class="mt-6 rounded-2xl border border-line bg-surface p-6 md:p-8">
        <ContactForm locale={locale} status={status} />
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-14" aria-labelledby="faq-h">
      <h2 id="faq-h" class="text-xl font-extrabold tracking-tight">FAQ</h2>
      <dl class="mt-5 divide-y divide-line border-y border-line">
        {
          faqs.map((f) => (
            <div class="py-4">
              <dt class="font-bold text-ink">{f.question}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-muted">{f.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

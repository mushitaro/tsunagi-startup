---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../PageHead.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';
import { getConsulting } from '../../lib/content';
import { SITE_URL, breadcrumbSchema, serviceSchema, faqSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const DISCORD_INVITE = 'https://discord.gg/a9bjUB4ndf';

const services = await getConsulting(locale);
const rendered = await Promise.all(
  services.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

// 進め方（デリバリーの考え方）。TSUNAGI は「データ」ではなく『作業』にフォーカスする。
// いまのアナログ作業こそ既に洗練されたもの。それを観察し、磨き込むイメージでモックを作る。
const approach = {
  ja: {
    label: '設計思想',
    intro: 'いま行っているアナログな作業は、すでに洗練されている。テクノロジーを使って、その練度をさらに高めていく。',
    paras: [
      `この「作業を受け継ぎ、見立て、磨き込む」プロセスを、個別の受託開発としてではなく、全国の現場がそのまま使える標準ソフトウェアとして結晶化させたものが『MOYAI』であり、基幹システムとの間を繋ぐ『MX Stage』です。現在、TSUNAGI では個別のシステム受託開発や短期の実証実験（PoC）の作業請負は行っておらず、公開プロダクトの提供と、コア技術（IP）を軸としたエンタープライズ連携に特化しています。`,
    ],
    readMore: '設計思想を TSUTAERU で読む',
    servicesLabel: '提供範囲',
    faqLabel: 'よくある質問',
    faq: [
      {
        q: '自治体や自社の現場で MOYAI を試したいのですが、費用や契約は必要ですか？',
        a: '必要ありません。MOYAI 本体と、ごみ焼却・し尿処理向けのスキルパックおよび公開台帳は Apache 2.0 ライセンスで公開しています。受託契約や予算申請を待つことなく、手元の PC にダウンロードしてそのまま現場の作業でお試しいただけます。',
      },
      {
        q: '個別のシステム開発や、補助金・実証事業（PoC）の委託をお願いできますか？',
        a: '申し訳ありませんが、個別案件ごとの受託開発、仕様書に基づくカスタマイズ作業、調査報告書の作成といった役務提供（外注・下請け業務）はお受けしていません。まずは公開している MOYAI をそのまま現場でお使いいただき、その先にある基幹システム連携（MCP）や全社展開が必要になった段階で、商用ライセンスまたはアライアンスとしてご相談ください。',
      },
      {
        q: 'いまの現場のやり方は、できれば変えたくないのですが。',
        a: 'それで大丈夫です。長く続いてきた作業や指定書式には、その現場なりに磨かれた理由が入っているので、置き換えるのではなく受け継ぐのが TSUNAGI の前提です。仕組みに人を合わせるのではなく、いまの作業のほうに AI と画面を寄せていくために MOYAI や MX Stage を作っています。',
      },
      {
        q: '商用ライセンス（MX Stage）や、知財・事業提携の相談方法は？',
        a: 'プロダクトの使い方やオープンソースに関するやり取りは Discord に集約しています。事業会社様による商用ライセンスの包括契約や、コア IP に関する戦略的アライアンスのご相談についても、まずは Discord より事業開発・経営企画のご担当者様から直接お声がけください。',
      },
    ],
    works: '実績は TSUKURU のプロダクト群をご覧ください',
  },
  en: {
    label: 'Design philosophy',
    intro: 'The analog work you do today is already refined. We use technology to take its craft a step further.',
    paras: [
      `This process of inheriting the work, curating it, and honing it has been crystallized, not as individual contract development, but as standard software that sites across Japan can use as is: that is MOYAI, together with MX Stage, which bridges it to core systems. TSUNAGI does not currently take on individual system development contracts or short-term proof-of-concept (PoC) work. We focus on providing our published products and on enterprise partnerships built around our core technology (IP).`,
    ],
    readMore: 'Read our design philosophy in TSUTAERU',
    servicesLabel: 'What we cover',
    faqLabel: 'FAQ',
    faq: [
      {
        q: 'We’d like to try MOYAI at our municipality or on our own sites. Is there a fee or a contract?',
        a: 'No. MOYAI itself, along with the skill packs and the public ledger for waste incineration and night-soil treatment, is published under the Apache 2.0 license. There is no need to wait for a contract or a budget request: download it to your PC and try it on your actual work right away.',
      },
      {
        q: 'Can we commission individual system development, or a subsidized or proof-of-concept (PoC) project?',
        a: 'We’re sorry, but we don’t take on services such as per-project contract development, customization to a specification, or writing research reports (outsourced or subcontracted work). Please start by using the published MOYAI as it is on site. When you reach the point of needing integration with core systems (MCP) or a company-wide rollout, talk to us about a commercial license or an alliance.',
      },
      {
        q: 'I’d rather not change the way we currently work on site.',
        a: 'That’s fine. Work and designated forms that have carried on for a long time hold reasons refined for that workplace, so at TSUNAGI the premise is to inherit them, not replace them. We build MOYAI and MX Stage so that the AI and the screens come closer to the work as it is now, instead of fitting people to a system.',
      },
      {
        q: 'How do we discuss a commercial license (MX Stage), or an IP or business alliance?',
        a: 'Conversations about using the products and about the open source are gathered on Discord. For comprehensive commercial license agreements with companies, or strategic alliances around our core IP, please also reach out to us directly on Discord first, from the person in charge of business development or corporate planning.',
      },
    ],
    works: 'See our work in TSUKURU',
  },
}[locale];

const base = locale === 'ja' ? SITE_URL : `${SITE_URL}/en`;
const jsonLd = [
  serviceSchema(locale),
  breadcrumbSchema([
    { name: 'tsunagi', url: `${base}/` },
    { name: t('consulting.title'), url: `${base}/tsunagu` },
  ]),
  faqSchema(approach.faq.map((f) => ({ question: f.q, answer: f.a }))),
];
---

<BaseLayout
  locale={locale}
  title={t('consulting.title')}
  description={t('consulting.lead')}
  jsonLd={jsonLd}
>
  <div class="wrap py-20 md:py-28">
    <PageHead num="03" mark="繋" title={t('consulting.title')} lead={t('consulting.lead')} />

    <!-- 進め方（デリバリーの考え方） -->
    <section class="mt-16" aria-labelledby="approach-h">
      <p class="text-sm font-semibold tracking-wide text-muted">{approach.label}</p>
      <h2
        id="approach-h"
        class="mt-5 max-w-3xl text-2xl leading-[1.5] text-ink md:text-[2rem]"
      >
        {approach.intro}
      </h2>
      <div class="mt-9 max-w-2xl space-y-5 text-[1.0625rem] leading-relaxed text-ink-soft">
        {approach.paras.map((p) => <p>{p}</p>)}
      </div>
      <!-- 設計思想の全文（核の思想の 4 段落）は TSUTAERU の記事に置いている -->
      <a
        href={localizedPath('/tsutaeru/how-we-work', locale)}
        class="mt-10 flex max-w-2xl items-center justify-between gap-4 border border-line px-7 py-6 transition-colors hover:bg-surface"
      >
        <span class="text-sm font-semibold tracking-wide text-ink">{approach.readMore}</span>
        <span class="text-sm text-muted">→</span>
      </a>
    </section>

    <!-- 提供範囲（サービス） -->
    <section class="mt-20" aria-labelledby="services-h">
      <p id="services-h" class="border-b border-line pb-4 text-sm font-semibold tracking-wide text-muted">
        {approach.servicesLabel}
      </p>
      <div class="[&>:first-child]:border-t-0">
        {
          rendered.map(({ entry, Content }, i) => (
            <section class="grid gap-x-10 gap-y-3 border-t border-line py-12 last:border-b md:grid-cols-[auto_1fr]">
              <span class="index-num text-2xl text-faint">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-2xl text-ink">{entry.data.title}</h3>
                <p class="mt-2 font-semibold text-ink-soft">{entry.data.summary}</p>
                <div class="article-body mt-4 text-[1rem]">
                  <Content />
                </div>
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- ポートフォリオへの導線 -->
    <a
      href={localizedPath('/tsukuru', locale)}
      class="mt-10 flex items-center justify-between gap-4 border border-line px-7 py-7 transition-colors hover:bg-surface"
    >
      <span class="text-sm font-semibold tracking-wide text-ink">{approach.works}</span>
      <span class="text-sm text-muted">→</span>
    </a>

    <!-- よくある質問 -->
    <section class="mt-20" aria-labelledby="faq-h">
      <p id="faq-h" class="border-b border-line pb-4 text-sm font-semibold tracking-wide text-muted">
        {approach.faqLabel}
      </p>
      <div>
        {
          approach.faq.map((f) => (
            <details class="group border-b border-line [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-bold text-ink transition-colors hover:text-ink-soft">
                <span>{f.q}</span>
                <span
                  aria-hidden="true"
                  class="shrink-0 text-xl leading-none text-faint transition-transform duration-200 group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="max-w-2xl pb-7 text-[15px] leading-relaxed text-ink-soft">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- 問い合わせ（Discord） -->
    <section id="contact" class="mt-20 scroll-mt-24" aria-labelledby="contact-h">
      <div class="border border-line bg-surface px-8 py-16 text-ink md:px-16">
        <p class="index-num text-xs uppercase text-muted">Discord</p>
        <h2 id="contact-h" class="mt-5 text-2xl leading-snug md:text-3xl">
          {t('consulting.contact.title')}
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
          {t('consulting.contact.desc')}
        </p>
        <a
          href={DISCORD_INVITE}
          target="_blank"
          rel="noopener"
          class="mt-9 inline-block bg-ink px-7 py-3.5 text-sm font-semibold tracking-wide text-paper transition-colors hover:bg-brand-ink"
        >
          {t('consulting.contact.join')} ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

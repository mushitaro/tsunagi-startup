---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../ContactForm.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';
import { getConsulting } from '../../lib/content';
import { SITE_URL, breadcrumbSchema, serviceSchema, faqSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const services = await getConsulting(locale);
const rendered = await Promise.all(
  services.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const discordInvite = Astro.locals.runtime?.env?.DISCORD_INVITE_URL || '#';
const contactParam = Astro.url.searchParams.get('contact');
const status =
  contactParam === 'ok' || contactParam === 'error' || contactParam === 'required'
    ? contactParam
    : null;

const faqs =
  locale === 'ja'
    ? [
        {
          question: 'どんな相談ができますか？',
          answer:
            '新規アプリの企画・設計から、既存アプリの開発・改修、公開後の運用改善まで一貫して相談できます。',
        },
        {
          question: '問い合わせ方法は？',
          answer:
            'お問い合わせは Discord に特化しています。サーバーに参加して直接ご相談いただくか、このページのフォームからお送りください。',
        },
        {
          question: '進め方は？',
          answer:
            'まず現状と課題をうかがい、スコープと進め方をすり合わせたうえでお見積もりします。小さく始めて運用しながら育てる進め方を基本にしています。',
        },
      ]
    : [
        {
          question: 'What can I ask about?',
          answer:
            'Everything from planning and designing a new app, to developing and reworking an existing one, to improving operations after launch.',
        },
        {
          question: 'How do I get in touch?',
          answer:
            'Inquiries are handled via Discord. Join the server to talk directly, or send a message with the form on this page.',
        },
        {
          question: 'How does a project proceed?',
          answer:
            'We start by understanding your situation and challenges, align on scope and approach, then provide an estimate. We default to starting small and growing through operation.',
        },
      ];

const base = locale === 'ja' ? SITE_URL : `${SITE_URL}/en`;
const jsonLd = [
  serviceSchema(locale),
  breadcrumbSchema([
    { name: 'tsunagi', url: `${base}/` },
    { name: t('consulting.title'), url: `${base}/tsunagu` },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  locale={locale}
  title={t('consulting.title')}
  description={t('consulting.lead')}
  jsonLd={jsonLd}
>
  <div class="wrap py-20 md:py-28">
    <header class="border-b border-line pb-10">
      <p class="index-num text-sm uppercase text-faint">03</p>
      <h1 class="mt-6 text-4xl font-bold text-ink md:text-6xl">{t('consulting.title')}</h1>
      <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-muted">{t('consulting.lead')}</p>
    </header>

    <!-- サービス（連番） -->
    <div class="mt-2">
      {
        rendered.map(({ entry, Content }, i) => (
          <section class="grid gap-x-10 gap-y-3 border-t border-line py-12 last:border-b md:grid-cols-[auto_1fr]">
            <span class="index-num text-base text-faint">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2 class="text-2xl font-bold text-ink">{entry.data.title}</h2>
              <p class="mt-2 font-semibold text-ink-soft">{entry.data.summary}</p>
              <div class="article-body mt-4 text-[1rem]">
                <Content />
              </div>
            </div>
          </section>
        ))
      }
    </div>

    <!-- ポートフォリオへの導線 -->
    <a
      href={localizedPath('/tsukuru', locale)}
      class="mt-10 flex items-center justify-between gap-4 border border-line px-7 py-7 transition-colors hover:bg-surface"
    >
      <span class="text-sm font-semibold tracking-wide text-ink">
        {locale === 'ja'
          ? '実績は Tsukuru のプロダクト群をご覧ください'
          : 'See our work in Tsukuru'}
      </span>
      <span class="text-sm text-faint">→</span>
    </a>

    <!-- 問い合わせ -->
    <section id="contact" class="mt-20 scroll-mt-24" aria-labelledby="contact-h">
      <div class="border border-line bg-surface px-8 py-16 text-ink md:px-16">
        <p class="index-num text-xs uppercase text-faint">Discord</p>
        <h2 id="contact-h" class="mt-5 text-2xl font-bold leading-snug md:text-3xl">
          {t('consulting.contact.title')}
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
          {t('consulting.contact.desc')}
        </p>
        <a
          href={discordInvite}
          target="_blank"
          rel="noopener"
          class="mt-9 inline-block bg-brand px-7 py-3.5 text-sm font-semibold tracking-wide text-paper transition-colors hover:bg-brand-ink"
        >
          {t('consulting.contact.join')} ↗
        </a>
      </div>

      <div class="border border-line border-t-0 bg-surface p-8 md:p-12">
        <ContactForm locale={locale} status={status} />
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-20" aria-labelledby="faq-h">
      <h2 id="faq-h" class="border-b border-line pb-4 text-xl font-bold tracking-tight">FAQ</h2>
      <dl class="mt-2">
        {
          faqs.map((f) => (
            <div class="border-b border-line py-7">
              <dt class="font-bold text-ink">{f.question}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-muted">{f.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';
import { organizationSchema, websiteSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const sections = [
  {
    href: localizedPath('/tsukuru', locale),
    name: t('nav.catalog'),
    desc: t('home.section.catalog.desc'),
  },
  {
    href: localizedPath('/tsutaeru', locale),
    name: t('nav.content'),
    desc: t('home.section.content.desc'),
  },
  {
    href: localizedPath('/tsunagu', locale),
    name: t('nav.consulting'),
    desc: t('home.section.consulting.desc'),
  },
];
---

<BaseLayout
  locale={locale}
  title="tsunagi"
  description={t('home.hero.lead')}
  jsonLd={[organizationSchema(), websiteSchema(locale)]}
>
  <!-- メッセージ + ブランドビジュアル -->
  <section class="flex min-h-svh flex-col justify-center">
    <!-- テキスト -->
    <div class="wrap py-32 md:py-48">
      <h1
        class="max-w-4xl text-[2.5rem] font-bold leading-[1.22] text-ink sm:text-6xl sm:leading-[1.16]"
      >
        {t('home.hero.title')}
      </h1>
      <p
        class="mt-12 max-w-xl border-t border-line pt-10 text-[15px] leading-relaxed text-muted"
      >
        {t('home.hero.lead')}
      </p>
    </div>
  </section>

  <!-- 各ページへのリンク（索引） -->
  <section class="wrap py-20" aria-label="sections">
    {
      sections.map((s, i) => (
        <a
          href={s.href}
          class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-x-6 border-t border-line py-10 transition-colors last:border-b hover:bg-surface md:gap-x-10"
        >
          <span class="index-num text-4xl text-faint">{String(i + 1).padStart(2, '0')}</span>
          <div class="md:flex md:items-baseline md:gap-8">
            <h2 class="text-3xl font-bold text-ink md:w-64 md:shrink-0">{s.name}</h2>
            <p class="mt-1.5 text-sm tracking-wide text-muted md:mt-0">{s.desc}</p>
          </div>
          <span class="text-sm text-faint transition-colors group-hover:text-ink">→</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

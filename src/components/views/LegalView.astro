---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, useTranslations } from '../../i18n';

interface Props {
  locale: Locale;
  doc: 'privacy' | 'terms';
}
const { locale, doc } = Astro.props;
const t = useTranslations(locale);
const title = doc === 'privacy' ? t('footer.privacy') : t('footer.terms');
const updated = '2026-10-02';

// 本サイトは静的サイト（アカウント・決済・フォームなし）。機能を足したら実態に合わせて改定すること。
type Sec = { h: string; p: string };
const content: Record<'privacy' | 'terms', Record<Locale, Sec[]>> = {
  privacy: {
    ja: [
      { h: '事業者', p: '「TSUNAGI」（以下「当方」）が tsunagi.app（以下「本サイト」）を運営します。' },
      { h: '取得する情報', p: '本サイトにはアカウント登録・決済・入力フォームの機能はなく、閲覧者から氏名やメールアドレスを直接取得することはありません。アクセス解析のため、Google アナリティクスにより閲覧ページ・参照元・端末やブラウザの種類などの情報が収集されます。' },
      { h: '利用目的', p: 'アクセス解析の情報は、本サイトの利用状況の把握と改善のためにのみ利用します。' },
      { h: 'Cookie とアクセス解析', p: '本サイトは Google アナリティクスを利用しており、そのために Cookie が使われます。収集されるデータは個人を特定するものではなく、Google のプライバシーポリシーに基づいて管理されます。Cookie はブラウザの設定で無効化できます。' },
      { h: '外部サービス', p: '受託のご相談は Discord で受け付けています。Discord 上でやり取りした情報は、Discord のプライバシーポリシーに従って扱われます。' },
      { h: '第三者提供', p: '法令に基づく場合等を除き、ご本人の同意なく個人情報を第三者に提供しません。' },
      { h: 'お問い合わせ', p: '本ポリシーに関するお問い合わせは、TSUNAGU ページに記載の Discord 経由で受け付けます。' },
      { h: '改定', p: '本ポリシーは必要に応じて改定します。重要な変更がある場合は本サイト上で告知します。' },
    ],
    en: [
      { h: 'Operator', p: '"TSUNAGI" (the "Operator") runs tsunagi.app (the "Site").' },
      { h: 'Information collected', p: 'The Site has no accounts, payments, or input forms, and does not directly collect names or email addresses from visitors. For analytics, Google Analytics collects information such as pages viewed, referrers, and device and browser types.' },
      { h: 'Purpose of use', p: 'Analytics information is used solely to understand and improve how the Site is used.' },
      { h: 'Cookies and analytics', p: 'The Site uses Google Analytics, which relies on cookies. The data collected does not identify individuals and is handled under Google\'s privacy policy. You can disable cookies in your browser settings.' },
      { h: 'External services', p: 'Project inquiries are handled on Discord. Information exchanged on Discord is handled under Discord\'s privacy policy.' },
      { h: 'Third parties', p: 'We do not provide personal information to third parties without your consent, except as required by law.' },
      { h: 'Contact', p: 'Inquiries about this policy are accepted via the Discord linked on the TSUNAGU page.' },
      { h: 'Revisions', p: 'This policy may be revised as needed. Significant changes will be announced on the Site.' },
    ],
  },
  terms: {
    ja: [
      { h: '適用', p: '本規約は、本サイト（tsunagi.app）の利用に関する一切の関係に適用されます。' },
      { h: '禁止事項', p: '本サイトのコンテンツの無断複製・再配布、本サイトの運営を妨げる行為、法令・公序良俗に反する行為を禁止します。' },
      { h: '外部リンク', p: '本サイトから紹介するアプリや外部サイトは、それぞれの規約に従ってご利用ください。リンク先の内容について当方は責任を負いません。' },
      { h: '知的財産', p: '本サイトのコンテンツに関する著作権その他の権利は、当方または正当な権利者に帰属します。' },
      { h: '免責', p: '当方は本サイトの情報の正確性・完全性を保証しません。利用により生じた損害について、当方の故意・重過失による場合を除き責任を負いません。' },
      { h: '準拠法', p: '本規約は日本法に準拠し、解釈されます。' },
      { h: '改定', p: '本規約は必要に応じて改定します。改定後の規約は本サイト上に表示した時点で効力を生じます。' },
    ],
    en: [
      { h: 'Scope', p: 'These terms apply to all use of the Site (tsunagi.app).' },
      { h: 'Prohibited conduct', p: 'Unauthorized copying or redistribution of Site content, interference with the Site, and unlawful conduct are prohibited.' },
      { h: 'External links', p: 'Apps and external sites introduced on the Site are subject to their own terms. The Operator is not responsible for the content of linked sites.' },
      { h: 'Intellectual property', p: 'Copyright and other rights in the Site content belong to the Operator or the rightful holders.' },
      { h: 'Disclaimer', p: 'The Operator does not warrant the accuracy or completeness of information on the Site, and is not liable for damages arising from use except in cases of willful misconduct or gross negligence.' },
      { h: 'Governing law', p: 'These terms are governed by and construed under the laws of Japan.' },
      { h: 'Revisions', p: 'These terms may be revised as needed. Revised terms take effect when posted on the Site.' },
    ],
  },
};
const sections = content[doc][locale];
---

<BaseLayout locale={locale} title={title} description={title}>
  <article class="wrap-narrow py-20 md:py-28">
    <p class="index-num text-xs uppercase text-faint">TSUNAGI</p>
    <h1 class="mt-6 text-4xl font-bold text-ink md:text-5xl">{title}</h1>
    <p class="index-num mt-4 text-[11px] text-faint">{updated}</p>
    <div class="mt-12">
      {
        sections.map((s, i) => (
          <section class="border-t border-line py-8 last:border-b">
            <h2 class="text-lg font-bold text-ink">
              <span class="index-num mr-3 text-xl text-faint">{String(i + 1).padStart(2, '0')}</span>
              {s.h}
            </h2>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{s.p}</p>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

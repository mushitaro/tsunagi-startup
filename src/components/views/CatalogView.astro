---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../PageHead.astro';
import AppCard from '../AppCard.astro';
import { type Locale, useTranslations } from '../../i18n';
import { getApps, nameFontsHref } from '../../lib/content';
import { SITE_URL, breadcrumbSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const apps = await getApps();
const fontsHref = nameFontsHref(apps);

const statusLabels: Record<string, { ja: string; en: string }> = {
  live: { ja: '公開中', en: 'Live' },
  'in-development': { ja: '開発中', en: 'In dev' },
  planned: { ja: '構想中', en: 'Planned' },
};
const order = ['live', 'in-development', 'planned'] as const;
const filters = [
  { key: 'all', label: t('catalog.filter.all'), count: apps.length },
  ...order
    .map((s) => ({
      key: s,
      label: statusLabels[s][locale],
      count: apps.filter((a) => a.data.status === s).length,
    }))
    .filter((f) => f.count > 0),
];

const base = locale === 'ja' ? SITE_URL : `${SITE_URL}/en`;
const crumbs = breadcrumbSchema([
  { name: 'tsunagi', url: `${base}/` },
  { name: t('catalog.title'), url: `${base}/tsukuru` },
]);
---

<BaseLayout
  locale={locale}
  title={t('catalog.title')}
  description={t('catalog.lead')}
  jsonLd={crumbs}
>
  {fontsHref && <link slot="head" rel="stylesheet" href={fontsHref} />}
  <div class="wrap py-20 md:py-28">
    <PageHead num="01" mark="作" title={t('catalog.title')} lead={t('catalog.lead')} />

    {
      apps.length > 0 ? (
        <>
          <div class="flex flex-wrap gap-x-7 gap-y-2 py-7" role="group" data-filter-bar>
            {filters.map((f, i) => (
              <button
                type="button"
                data-filter={f.key}
                aria-pressed={i === 0 ? 'true' : 'false'}
                class="text-[13px] font-semibold tracking-wide text-muted underline-offset-[6px] transition-colors hover:text-ink aria-pressed:text-ink aria-pressed:underline aria-pressed:decoration-1"
              >
                {f.label}
                <span class="index-num ml-1.5 text-[11px] text-muted">{f.count}</span>
              </button>
            ))}
          </div>

          <div class="grid gap-5 sm:grid-cols-2" data-app-grid>
            {apps.map((app) => (
              <div data-status={app.data.status}>
                <AppCard app={app} locale={locale} />
              </div>
            ))}
          </div>
          <p class="mt-8 hidden text-sm text-muted" data-empty>
            {t('catalog.empty')}
          </p>
        </>
      ) : (
        <p class="mt-12 text-muted">{t('catalog.empty')}</p>
      )
    }
  </div>
</BaseLayout>

<script>
  // ステータスでカードを絞り込む（JS 無効時は全件表示）。
  const bar = document.querySelector('[data-filter-bar]');
  const cards = Array.from(document.querySelectorAll('[data-app-grid] > [data-status]'));
  const empty = document.querySelector('[data-empty]');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-filter]');
    if (!btn) return;
    const key = btn.getAttribute('data-filter');
    bar.querySelectorAll('button').forEach((b) =>
      b.setAttribute('aria-pressed', String(b === btn)),
    );
    let visible = 0;
    cards.forEach((c) => {
      const show = key === 'all' || c.getAttribute('data-status') === key;
      (c as HTMLElement).hidden = !show;
      if (show) visible++;
    });
    empty?.classList.toggle('hidden', visible !== 0);
  });
</script>

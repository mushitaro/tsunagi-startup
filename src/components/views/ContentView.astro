---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../ArticleCard.astro';
import { type Locale, useTranslations } from '../../i18n';
import { getArticles } from '../../lib/content';
import { SITE_URL, breadcrumbSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const articles = await getArticles(locale);

const base = locale === 'ja' ? SITE_URL : `${SITE_URL}/en`;
const crumbs = breadcrumbSchema([
  { name: 'tsunagi', url: `${base}/` },
  { name: t('content.title'), url: `${base}/tsutae` },
]);
---

<BaseLayout
  locale={locale}
  title={t('content.title')}
  description={t('content.lead')}
  jsonLd={crumbs}
>
  <div class="wrap py-20 md:py-28">
    <header class="border-b border-line pb-10">
      <p class="index-num text-sm uppercase text-faint">02</p>
      <h1 class="mt-6 text-4xl font-bold text-ink md:text-6xl">{t('content.title')}</h1>
      <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-muted">{t('content.lead')}</p>
    </header>

    {
      articles.length > 0 ? (
        <div class="mt-2">
          {articles.map((article) => (
            <ArticleCard article={article} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="mt-12 text-muted">{t('content.empty')}</p>
      )
    }
  </div>
</BaseLayout>

---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Paywall from '../Paywall.astro';
import ArticleCard from '../ArticleCard.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';
import {
  type ArticleEntry,
  entrySlug,
  formatDate,
  formatPrice,
  getArticle,
  getArticles,
} from '../../lib/content';
import { SITE_URL, articleSchema, breadcrumbSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
  article: ArticleEntry;
  entitled: boolean;
  loggedIn: boolean;
}
const { locale, article, entitled, loggedIn } = Astro.props;
const t = useTranslations(locale);
const d = article.data;
const slug = entrySlug(article.id);
const paid = d.access === 'paid';

const otherLocale: Locale = locale === 'ja' ? 'en' : 'ja';
const hasTranslation = !!(await getArticle(otherLocale, slug));

// 本文は entitled のときだけレンダリングする（未購入なら HTML に一切含めない）。
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
if (entitled) {
  Content = (await render(article)).Content;
}

// 関連記事: タグの重なりが多い順 → 新しい順。
const related = (await getArticles(locale))
  .filter((a) => entrySlug(a.id) !== slug)
  .map((a) => ({ a, score: a.data.tags.filter((tg) => d.tags.includes(tg)).length }))
  .sort((x, y) => y.score - x.score || y.a.data.publishedAt.getTime() - x.a.data.publishedAt.getTime())
  .slice(0, 3)
  .map((x) => x.a);

const base = locale === 'ja' ? SITE_URL : `${SITE_URL}/en`;
const canonical = `${base}/content/${slug}`;
const jsonLd = [
  articleSchema({
    headline: d.title,
    description: d.summary,
    url: canonical,
    locale,
    datePublished: d.publishedAt,
    dateModified: d.updatedAt,
    image: d.coverImage ? new URL(d.coverImage, SITE_URL).href : undefined,
    isPaid: paid,
  }),
  breadcrumbSchema([
    { name: 'tsunagi', url: `${base}/` },
    { name: t('content.title'), url: `${base}/content` },
    { name: d.title, url: canonical },
  ]),
];
---

<BaseLayout
  locale={locale}
  title={d.title}
  description={d.summary}
  ogType="article"
  ogImage={d.coverImage}
  noAlternate={!hasTranslation}
  jsonLd={jsonLd}
>
  <article class="wrap-narrow py-20 md:py-28">
    <a
      href={localizedPath('/content', locale)}
      class="text-[13px] font-semibold tracking-wide text-muted transition-colors hover:text-ink"
    >
      ← {t('content.back')}
    </a>

    <header class="mt-10 border-b border-line pb-9">
      <div class="flex flex-wrap items-center gap-x-4 text-[11px] tracking-wide">
        <time class="text-faint" datetime={d.publishedAt.toISOString()}>
          {t('content.published')} {formatDate(d.publishedAt, locale)}
        </time>
        {
          d.updatedAt && (
            <time class="text-faint" datetime={d.updatedAt.toISOString()}>
              / {t('content.updated')} {formatDate(d.updatedAt, locale)}
            </time>
          )
        }
        {
          paid ? (
            <span class="font-semibold uppercase tracking-[0.16em] text-ink">
              {t('access.paid')}
              {d.price && <span class="ml-1.5">{formatPrice(d.price, d.currency)}</span>}
            </span>
          ) : (
            <span class="uppercase tracking-[0.16em] text-faint">{t('access.free')}</span>
          )
        }
      </div>
      <h1 class="mt-5 text-3xl font-bold leading-[1.3] text-ink md:text-5xl md:leading-[1.22]">
        {d.title}
      </h1>
      {
        d.tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-1">
            {d.tags.map((tag) => (
              <span class="text-[11px] tracking-wide text-faint">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      d.coverImage && (
        <img
          src={d.coverImage}
          alt=""
          width="1280"
          height="640"
          class="mt-10 aspect-[2/1] w-full border border-line object-cover"
        />
      )
    }

    <!-- summary は常に公開（無料プレビュー / SEO / AIO） -->
    <p class="mt-10 text-lg leading-relaxed text-ink-soft">{d.summary}</p>

    {
      entitled && Content ? (
        <>
          {paid && (
            <p class="mt-7 border-l-2 border-ink pl-3 text-sm font-semibold text-ink-soft">
              {t('paywall.owned')}
            </p>
          )}
          <div class="article-body mt-8">
            <Content />
          </div>
        </>
      ) : (
        <Paywall locale={locale} article={article} loggedIn={loggedIn} />
      )
    }

    {
      related.length > 0 && (
        <section class="mt-20 border-t border-line pt-12" aria-labelledby="related">
          <h2 id="related" class="text-xl font-bold tracking-tight">
            {t('content.related')}
          </h2>
          <div class="mt-3">
            {related.map((a) => (
              <ArticleCard article={a} locale={locale} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

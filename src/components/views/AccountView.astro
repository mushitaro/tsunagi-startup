---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';
import { getPurchases } from '../../lib/db';
import { getArticle, entrySlug, formatDate, formatPrice } from '../../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const user = Astro.locals.user;

const params = Astro.url.searchParams;
const sent = params.get('sent') === '1';
const error = params.get('error') === '1';
const verifyFail = params.get('verify') === 'fail';
const verifyOk = params.get('verify') === 'ok';
const next = params.get('next') ?? '';

type PurchaseItem = {
  title: string;
  href: string | null;
  amount: number | null;
  currency: string | null;
  date: Date;
};
let purchases: PurchaseItem[] = [];
if (user) {
  const rows = await getPurchases(Astro.locals.runtime.env.DB, user.id);
  for (const r of rows) {
    const art = (await getArticle(locale, r.article_slug)) ?? (await getArticle('ja', r.article_slug));
    purchases.push({
      title: art?.data.title ?? r.article_slug,
      href: art ? localizedPath(`/content/${entrySlug(art.id)}`, locale) : null,
      amount: r.amount,
      currency: r.currency,
      date: new Date(r.created_at),
    });
  }
}

const field =
  'mt-2 w-full border border-line-strong bg-paper px-3.5 py-3 text-sm outline-none transition-colors focus:border-ink';
---

<BaseLayout
  locale={locale}
  title={user ? t('auth.account.title') : t('auth.title')}
  description={t('auth.lead')}
  noindex
  noAlternate
>
  <div class="wrap-narrow py-20 md:py-28">
    {
      user ? (
        <>
          <h1 class="text-4xl font-bold text-ink md:text-5xl">{t('auth.account.title')}</h1>

          <div class="mt-10 border border-line p-6">
            <p class="index-num text-[11px] uppercase text-faint">{t('auth.account.email')}</p>
            <p class="mt-2 font-semibold text-ink">{user.email}</p>
            <form method="POST" action="/api/auth/logout" class="mt-5">
              <input type="hidden" name="locale" value={locale} />
              <button
                type="submit"
                class="border border-line-strong px-5 py-2.5 text-[13px] font-semibold tracking-wide text-ink-soft transition-colors hover:border-ink"
              >
                {t('auth.logout')}
              </button>
            </form>
          </div>

          {verifyOk && (
            <p class="mt-6 border-l-2 border-ink pl-3 text-sm font-semibold text-ink-soft">
              {t('auth.verify.ok')}
            </p>
          )}

          <h2 class="mt-14 border-b border-line pb-4 text-xl font-bold tracking-tight">
            {t('auth.account.purchases')}
          </h2>
          {purchases.length > 0 ? (
            <ul>
              {purchases.map((p) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-line py-5">
                  <div class="min-w-0">
                    {p.href ? (
                      <a
                        href={p.href}
                        class="font-bold text-ink decoration-1 underline-offset-4 hover:underline"
                      >
                        {p.title}
                      </a>
                    ) : (
                      <span class="font-bold text-ink">{p.title}</span>
                    )}
                    <p class="index-num mt-1 text-[11px] text-faint">{formatDate(p.date, locale)}</p>
                  </div>
                  {p.amount != null && (
                    <span class="shrink-0 text-sm font-semibold text-muted">
                      {formatPrice(p.amount, p.currency ?? 'jpy')}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-5 text-muted">{t('auth.account.nopurchases')}</p>
          )}
        </>
      ) : sent ? (
        <div class="border border-line p-10 text-center">
          <p class="index-num text-xs uppercase text-faint">tsunagi</p>
          <h1 class="mt-5 text-2xl font-bold text-ink">{t('auth.sent.title')}</h1>
          <p class="mt-3 text-sm leading-relaxed text-muted">{t('auth.sent.desc')}</p>
        </div>
      ) : (
        <>
          <h1 class="text-4xl font-bold text-ink md:text-5xl">{t('auth.title')}</h1>
          <p class="mt-5 max-w-md text-[15px] leading-relaxed text-muted">{t('auth.lead')}</p>

          {verifyFail && (
            <p class="mt-6 border border-ink bg-surface px-4 py-3 text-sm font-semibold text-ink">
              {t('auth.verify.fail')}
            </p>
          )}
          {error && (
            <p class="mt-6 border border-ink bg-surface px-4 py-3 text-sm font-semibold text-ink">
              {t('auth.error')}
            </p>
          )}

          <form method="POST" action="/api/auth/request" class="mt-9 max-w-md">
            <input type="hidden" name="locale" value={locale} />
            {next && <input type="hidden" name="next" value={next} />}
            <label class="block">
              <span class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-muted">
                {t('auth.email')}
              </span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class={field}
                placeholder="you@example.com"
              />
            </label>
            <button
              type="submit"
              class="mt-5 w-full bg-ink px-5 py-3.5 text-sm font-semibold tracking-wide text-paper transition-colors hover:bg-brand-ink"
            >
              {t('auth.send')}
            </button>
          </form>
        </>
      )
    }
  </div>
</BaseLayout>

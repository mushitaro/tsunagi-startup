---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';
import { getPurchases } from '../../lib/db';
import { getArticle, entrySlug, formatDate, formatPrice } from '../../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const user = Astro.locals.user;

const params = Astro.url.searchParams;
const sent = params.get('sent') === '1';
const error = params.get('error') === '1';
const verifyFail = params.get('verify') === 'fail';
const verifyOk = params.get('verify') === 'ok';
const next = params.get('next') ?? '';

// 購入済み記事の解決（slug はロケール非依存。現在ロケール→ja の順で記事を引く）。
type PurchaseItem = {
  slug: string;
  title: string | null;
  href: string | null;
  amount: number | null;
  currency: string | null;
  date: Date;
};
let purchases: PurchaseItem[] = [];
if (user) {
  const rows = await getPurchases(Astro.locals.runtime.env.DB, user.id);
  for (const r of rows) {
    const art = (await getArticle(locale, r.article_slug)) ?? (await getArticle('ja', r.article_slug));
    purchases.push({
      slug: r.article_slug,
      title: art?.data.title ?? r.article_slug,
      href: art ? localizedPath(`/content/${entrySlug(art.id)}`, locale) : null,
      amount: r.amount,
      currency: r.currency,
      date: new Date(r.created_at),
    });
  }
}
---

<BaseLayout
  locale={locale}
  title={user ? t('auth.account.title') : t('auth.title')}
  description={t('auth.lead')}
  noindex
  noAlternate
>
  <div class="wrap-narrow py-16">
    {
      user ? (
        <>
          <h1 class="text-3xl font-extrabold tracking-tight">{t('auth.account.title')}</h1>
          <div class="mt-6 rounded-xl border border-line bg-surface p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-faint">
              {t('auth.account.email')}
            </p>
            <p class="mt-1 font-semibold">{user.email}</p>
            <form method="POST" action="/api/auth/logout" class="mt-4">
              <input type="hidden" name="locale" value={locale} />
              <button
                type="submit"
                class="rounded-lg border border-line-strong px-4 py-2 text-sm font-semibold text-ink-soft transition-colors hover:border-brand hover:text-brand"
              >
                {t('auth.logout')}
              </button>
            </form>
          </div>

          <h2 class="mt-10 text-lg font-extrabold tracking-tight">
            {t('auth.account.purchases')}
          </h2>
          {purchases.length > 0 ? (
            <ul class="mt-4 space-y-3">
              {purchases.map((p) => (
                <li class="flex items-center justify-between gap-4 rounded-xl border border-line bg-surface p-4">
                  <div class="min-w-0">
                    {p.href ? (
                      <a href={p.href} class="font-semibold text-ink hover:text-brand">
                        {p.title}
                      </a>
                    ) : (
                      <span class="font-semibold text-ink">{p.title}</span>
                    )}
                    <p class="mt-0.5 text-xs text-faint">{formatDate(p.date, locale)}</p>
                  </div>
                  {p.amount != null && (
                    <span class="shrink-0 text-sm font-bold text-muted">
                      {formatPrice(p.amount, p.currency ?? 'jpy')}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-muted">{t('auth.account.nopurchases')}</p>
          )}
        </>
      ) : sent ? (
        <div class="rounded-2xl border border-line bg-surface p-8 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-soft text-brand">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="2" />
              <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="2" />
            </svg>
          </div>
          <h1 class="mt-4 text-xl font-extrabold tracking-tight">{t('auth.sent.title')}</h1>
          <p class="mt-2 text-sm text-muted">{t('auth.sent.desc')}</p>
        </div>
      ) : (
        <>
          <h1 class="text-3xl font-extrabold tracking-tight">{t('auth.title')}</h1>
          <p class="mt-3 text-muted">{t('auth.lead')}</p>
          {verifyFail && (
            <p class="mt-4 rounded-lg border border-ink bg-surface px-3 py-2 text-sm font-semibold text-ink">
              {t('auth.verify.fail')}
            </p>
          )}
          {error && (
            <p class="mt-4 rounded-lg border border-ink bg-surface px-3 py-2 text-sm font-semibold text-ink">
              {t('auth.error')}
            </p>
          )}
          <form method="POST" action="/api/auth/request" class="mt-6 space-y-3">
            <input type="hidden" name="locale" value={locale} />
            {next && <input type="hidden" name="next" value={next} />}
            <label class="block">
              <span class="text-sm font-semibold text-ink-soft">{t('auth.email')}</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="mt-1.5 w-full rounded-lg border border-line-strong bg-surface px-3 py-2.5 text-sm outline-none focus:border-brand"
                placeholder="you@example.com"
              />
            </label>
            <button
              type="submit"
              class="w-full rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-ink"
            >
              {t('auth.send')}
            </button>
          </form>
        </>
      )
    }
    {
      user && verifyOk && (
        <p class="mt-6 text-sm font-semibold text-ink-soft">{t('auth.verify.ok')}</p>
      )
    }
  </div>
</BaseLayout>

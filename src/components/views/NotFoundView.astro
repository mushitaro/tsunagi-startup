---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, useTranslations, localizedPath } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t('404.title')}
  description={t('404.desc')}
  noindex
  noAlternate
>
  <div class="wrap flex flex-col items-start py-32 md:py-48">
    <p class="index-num text-sm text-faint">404</p>
    <h1 class="mt-6 text-4xl font-bold text-ink md:text-6xl">{t('404.title')}</h1>
    <p class="mt-4 max-w-md leading-relaxed text-muted">{t('404.desc')}</p>
    <a
      href={localizedPath('/', locale)}
      class="mt-10 bg-ink px-7 py-3.5 text-sm font-semibold tracking-wide text-paper transition-colors hover:bg-brand-ink"
    >
      {t('404.home')}
    </a>
  </div>
</BaseLayout>

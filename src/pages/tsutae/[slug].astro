---
export const prerender = false;

import ArticleView from '../../components/views/ArticleView.astro';
import NotFoundView from '../../components/views/NotFoundView.astro';
import { getArticleEntitlement } from '../../lib/article';

const locale = 'ja' as const;
const slug = Astro.params.slug ?? '';
const user = Astro.locals.user;

// 有料記事はユーザーごとに出し分けるためキャッシュ禁止。
Astro.response.headers.set('Cache-Control', 'private, no-store');

const checkoutSuccess = Astro.url.searchParams.get('checkout') === 'success';
const sessionId = checkoutSuccess ? Astro.url.searchParams.get('session_id') : null;

const result = await getArticleEntitlement({
  env: Astro.locals.runtime.env,
  locale,
  slug,
  user,
  checkoutSessionId: sessionId,
});
if (!result) Astro.response.status = 404;
---

{
  result ? (
    <ArticleView
      locale={locale}
      article={result.article}
      entitled={result.entitled}
      loggedIn={!!user}
    />
  ) : (
    <NotFoundView locale={locale} />
  )
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsunagi-startup",
  // @astrojs/cloudflare v12 のビルド出力（astro build で生成される）
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // D1: ユーザー / マジックリンクトークン / 購入権 / レート制限を保存。
  // database_id は `wrangler d1 create tsunagi_db` 後に置き換える。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsunagi_db",
      "database_id": "af2961a6-2e0b-4de3-8a33-f2e65b7be5b1",
      "migrations_dir": "migrations"
    }
  ],
  // KV: @astrojs/cloudflare が Astro セッション用に要求するバインディング。
  // id は `wrangler kv namespace create SESSION` 後に置き換える。
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "c87551721cca4105935c4159cc2f12d8"
    }
  ],
  // 非機密の設定値。機密値（APIキー等）は `wrangler secret put` で登録する。
  "vars": {
    "PUBLIC_SITE_URL": "https://tsunagi.app",
    "RESEND_FROM": "tsunagi <noreply@tsunagi.app>",
    "DISCORD_INVITE_URL": "https://discord.gg/a9bjUB4ndf"
  }
}

# 計測タグ用の公開ビルド変数（PUBLIC_ 接頭辞はクライアントに露出する＝シークレットではない）。
# 本番では GitHub リポジトリの Variables（Settings → Secrets and variables → Actions → Variables）に登録し、
# deploy.yml のビルドステップに渡す。ローカルで試すときは .env にコピーして値を入れる。

# Google Search Console のサイト所有権確認トークン（メタタグ方式）
PUBLIC_GSC_VERIFICATION=

# Cloudflare Web Analytics のトークン（Cloudflare ダッシュボード → Web Analytics で発行）
PUBLIC_CF_BEACON_TOKEN=
